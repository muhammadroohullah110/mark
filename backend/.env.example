# ============================================================
#  Mark backend — environment template
#  Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
#  Only GROQ_API_KEY is required to boot; everything else has safe defaults.
# ============================================================

# ── LLM (required) ──────────────────────────────────────────
# Free key from https://console.groq.com  → API Keys
GROQ_API_KEY=

# Optional: pool several Groq keys (comma-separated) to spread the free rate limit
GROQ_API_KEYS=

# Optional fallbacks — tried in order after Groq. Add any you have.
MOONSHOT_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional model-id overrides (sane defaults baked in)
# GROQ_MODEL=
# MOONSHOT_MODEL=
# FALLBACK_LLM_MODEL=

# ── Database ────────────────────────────────────────────────
# Postgres URL for production. Leave blank for a local SQLite file (dev).
DATABASE_URL=

# ── URLs / CORS ─────────────────────────────────────────────
BACKEND_PUBLIC_URL=https://mark-udfz.onrender.com
# Comma-separated allowlist locks the ADMIN API to your dashboard domain.
# Leave blank to allow all origins (needed for the embeddable widget; creds off).
ALLOWED_ORIGINS=
# Where the widget's static assets are served from (defaults to jsDelivr off this repo)
# EMBED_ASSET_BASE=

# ── Voice (optional — free Edge TTS works with none of these) ──
# PREMIUM_TTS=openai
# PREMIUM_TTS_MODEL=gpt-4o-mini-tts
# PREMIUM_TTS_VOICE=
# PREMIUM_TTS_INSTRUCTIONS=
# CARTESIA_API_KEY=
# CARTESIA_VOICE=

# ── Cost firewall / quotas (per store, per month; 0 = unlimited) ──
FREE_MONTHLY_QUOTA=500
STARTER_MONTHLY_QUOTA=2000
PRO_MONTHLY_QUOTA=10000
BUSINESS_MONTHLY_QUOTA=0
GLOBAL_MONTHLY_CAP=0
STORE_RATE_PER_MIN=120
COST_PER_CHAT_USD=0.001

# ── Billing (Stripe) — leave blank to keep billing inert ────
STRIPE_SECRET_KEY=
# JSON map of Stripe price id -> plan (starter|pro|business|premium)
STRIPE_PRICE_TIERS=
# Legacy single premium price (folded in as -> premium)
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
BILLING_SUCCESS_URL=https://markai.shop/?upgrade=success
BILLING_CANCEL_URL=https://markai.shop/?upgrade=cancelled

# ── Observability ───────────────────────────────────────────
# Set to any secret to unlock GET /api/ops/metrics (X-Ops-Key header). Unset = 404.
OPS_METRICS_KEY=

# ── Auth / misc ─────────────────────────────────────────────
WP_SHARED_SECRET=
ENABLE_LOGGING=true
MAX_CRAWL_PAGES=120

# ── Kill-switches (disable brain layers without a redeploy) ──
# SALES_CORTEX=0
# SALES_BOOST=0
